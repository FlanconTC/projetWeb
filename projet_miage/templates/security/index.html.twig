{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-3" style="background-color:grey"></div>
            <div class="col-sm-6" style="text-align:center">
                <div class="login-container">
                    <h1><u>Se connecter</u></h1>
                    {% if error is defined %}
                        {% if error %}
                            <div class="alert alert-danger">
                                {{ error }}
                            </div>
                        {% endif %}
                    {% endif %}
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-sm-3"></div>
                            <div class="col-sm-6" style="text-align:center">
                                <form method="post" >
                                    <div class="form-group">
                                        <label for="username">Nom d'utilisateur</label>
                                        <input type="text" id="username" name="_username" class="form-control" value="{{ last_username }}" required autofocus>
                                    </div>
                                    <br>
                                    <div class="form-group">
                                        <label for="password">Mot de passe</label>
                                        <input type="password" id="password" name="_password" class="form-control" required>
                                    </div>
                                    <br>
                                    <div class="form-group">
                                        <a action="{{ path('app_login') }}"><button type="submit" class="btn btn-primary">Se connecter</button></a>
                                    </div>
                                </form>
                            </div>
                            <div class="col-sm-3"></div>
                        </div>
                     </div>
                </div>
                <b>
                    Vous n'avez pas encore de compte ? 
                    <br>
                    <a href="{{ path('app_registerD') }}">Inscrivez-vous en tant que dev !</a>
                    <br>
                    <a href="{{ path('app_registerE') }}">Inscrivez-vous en tant qu'entreprise !</a>
                </b>
            </div>
            <div class="col-sm-3"  style="background-color:grey"></div>
        </div>
    </div>
{% endblock %}
