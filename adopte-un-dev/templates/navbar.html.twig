{% extends 'base.html.twig' %}

{% block title %}Navbar{% endblock %}
{% block nav %}
<div class="container">
    <nav class="navbar navbar-expand-lg bg-light">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">Adopte un dev</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    {% if app.request.pathInfo ends with '/' %}
                    <li class="nav-item">
                        <a class="nav-link  active" aria-current="page"  href="{{ path('app_home_page') }}">Matching</a>
                    </li>
                    {% else %}
                    <li class="nav-item">
                        <a class="nav-link" aria-current="page"  href="{{ path('app_home_page') }}">Matching</a>
                    </li>
                    {% endif %}
                    {% if app.request.pathInfo ends with '/messagerie' %}
                    <li class="nav-item">
                        <a class="nav-link active"  href="{{ path('app_messagerie') }}">Messagerie</a>
                    </li>
                    {% else %}
                    <li class="nav-item">
                        <a class="nav-link"  href="{{ path('app_messagerie') }}">Messagerie</a>
                    </li>
                    {% endif %}
                    {% if app.request.pathInfo ends with '/profil' %}
                    <li class="nav-item">
                        <a class="nav-link active"  href="{{ path('app_profil') }}">Profil</a>
                    </li>
                    {% else %}
                    <li class="nav-item">
                        <a class="nav-link"  href="{{ path('app_profil') }}">Profil</a>
                    </li>
                    {% endif %}
                    
                </ul>
                <form class="d-flex  ms-auto" role="search" action="/search" method="GET" >
                        <input class="form-control me-2" type="search" name="q" placeholder="Un poste en vue ?" aria-label="Search">
                    <button class="btn btn-outline-success" type="submit">Rechercher</button>
                </form>
            </div>
        </div>
    </nav>
</div>    
{% endblock %}
{% block body %}{% endblock %}