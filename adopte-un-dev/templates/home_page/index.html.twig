{% extends 'base.html.twig' %}

{% block title %}Swipez, jobez !{% endblock %}

{% block body %}

{% if is_granted("IS_AUTHENTICATED_REMEMBERED") %}

<div class="container">
    <div class="mt-4 p-5 bg-dark text-white rounded">
        <div id="user-info-container">
            <div class="row">
                <div class="col-md-4">
                    <h2 id="user-nameE"></h2>
                    <img id="user-icon" src="/avatars/empty.jpg" alt="Avatar" class="rounded-circle shadow" style="width: 150px; height: 150px;">
                </div>
                <div class="col-md-4">
                    <p id="user-name"></p>
                    <p id="user-email"></p>
                    <p id="user-bio"></p>
                    <button id="next-user-btn">Suivant</button>
                </div>
                <div class="col-md-4">
                    <p id="user-location"></p>
                    <p id="user-prog"></p>
                    <p id="user-exp"></p>
                    <p id="user-minS"></p>
                </div>
                   
            </div>
        </div>
    </div>
    <div class="mt-4 p-5 bg-dark text-white rounded">
        <div class="row">
            <div class="col-md-4">
                <h2>Paramètres de recherche :</h2>
                <label>
                    <input type="checkbox" id="dev" checked="true">
                    Voir des profils de développeurs
                </label>
                <br>
                <label>
                    <input type="checkbox" id="poste">
                    Voir des fiches de poste
                </label> 
                <br>
                <br>
                <br>
                <button type="button" id="valFiltre" class="btn btn-secondary">Appliquer les filtres</button>
            </div>
            <br>
            <br>
            Technologie(s) 
            <br>
            recherchée(s):
            <br>
            <br>
            Localisation :
            <div class="col-md-3">
                <select id="multiSelect" multiple size="5">
                    <option value="php">PHP</option>
                    <option value="javascript">JavaScript</option>
                    <option value="python">Python</option>
                    <option value="java">Java</option>
                    <option value="csharp">C#</option>
                    <option value="cplusplus">C++</option>
                    <option value="ruby">Ruby</option>
                    <option value="go">Go</option>
                    <option value="rust">Rust</option>
                    <option value="typescript">TypeScript</option>
                    <option value="swift">Swift</option>
                    <option value="kotlin">Kotlin</option>
                </select>
                <input type="textbox" id="localisation">
            </div>
            <div class="col-md-4">
                <p id="salaireSouhait">Salaire souhaité (max) :</p>
                <input type="textbox" id="salaire">
                <br>
                <br>
                <p>Note minimum :</p>
                <input type="range" id="ratingInput" min="1" max="5" step="1" value="3">
                <span id="ratingValue">3</span>
            </div>
        </div>
    </div>
</div>
{% endif %}

{% endblock %}
