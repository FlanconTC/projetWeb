{% extends 'base.html.twig' %}

{% block title %}Mes Favoris
{% endblock %}

{% block body %}
<div class="container mt-5">
		<div class="row justify-content-center">
			<div class="col-md-8">
				
                    <div class="col-md-4">
                       <table class="table">
                            <thead>
                                <tr>
                                <th scope="col">Développeurs</th>
                                </tr>
                            </thead>
                            <tbody>
                                
                                {% for dev in devs %}
                                    
                                    <tr>
                                    <td>
                                    <a href="{{path('favoris_add', {'idAdd':dev.id ,'addType' :'dev'}) }}">{{dev.username}}
                                    </td>
                                    </tr>
                                   
                                {% endfor %}
                                
                           
                            </table>
                            </div>
                            <div class="col-md-4">
                            <table class="table">
                            <thead>
                                <tr>
                                <th scope="col">Postes</th>
                                </tr>
                            </thead>
                            <tbody>
                                
                                {% for poste in postes %}
                                   
                                    <tr>
                                    <td>
                                    <a href="{{path('favoris_add', {'idAdd':poste.id,'addType' :'poste' }) }}">{{poste.title}}
                                    </td>
                                    </tr>
                                    
                                {% endfor %}
                                
                            </tbody>
                            </table>
                           </div>
                           
                        
                       {{test}}
                        
                    
			</div>
		</div>
	</div>

{% endblock %}