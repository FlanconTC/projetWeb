{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}
{% block nav %}
{% endblock %}
{% block body %}
    <div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h1 class="h3 mb-3 font-weight-normal text-center">Connectez-vous</h1>
                    <form method="post">
                        {% if error %}
                            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                        {% endif %}

                        {% if app.user %}
                            <div class="alert alert-success">
                                Connecté en tant que {{ app.user.userIdentifier }}.
                                <a href="{{ path('app_logout') }}">Se déconnecter</a>
                            </div>
                        {% endif %}

                        <div class="form-group">
                            <label for="username">Nom d'utilisateur ou d'entreprise</label>
                            <input type="text" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="username" required autofocus>
                        </div>

                        <div class="form-group">
                            <label for="password">Mot de passe</label>
                            <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                        <div class="checkbox mb-3">
                            <input type="checkbox" name="_remember_me" id="_remember_me">
                            <label for="_remember_me">Se souvenir de moi (pendant 7 jours)</label>
                        </div>

                        <button class="btn btn-md btn-primary btn-block" type="submit">Connexion</button>

                        <p class="mt-3 text-center">
                            Pas encore inscrit ?
                            <a href="{{ path('register_developer') }}">Développeur</a> /
                            <a href="{{ path('register_company') }}">Entreprise</a>.
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}
